# ── Auth.js (NextAuth v5) ───────────────────────────────────────────
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB — stores users, classes, enrollments, orders, products, reports.
# Auto-injected by the MongoDB Atlas marketplace integration on Vercel.
MONGODB_URI=

# Public base URL of the site, used in emails (order/report links).
SITE_URL=https://your-domain.com

# ── Stripe (shop checkout + class enrollment) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email / SMTP (contact form, order & report notifications) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ── Shop shipping config (optional; defaults shown) ─────────────────
SHOP_FLAT_SHIPPING=5.99
SHOP_FREE_SHIPPING_THRESHOLD=50

# ── Printful (apparel fulfillment) ──────────────────────────────────
PRINTFUL_API_KEY=
PRINTFUL_WEBHOOK_SECRET=

# ── Lulu (book print-on-demand) ─────────────────────────────────────
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_PDF_BASE_URL=

# ── Vercel Blob (report-card PDF storage) ───────────────────────────
# Auto-injected when you create a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# ── Vercel Cron (hourly Lulu shipping poll) ─────────────────────────
# Any random string; the /api/cron/poll-lulu route checks it. openssl rand -hex 16
CRON_SECRET=
